CONFIG_BOARD_TYPE_LCDWIKI_ES3C35P=y
# Stable backend bootstrap seed. The OTA response returns the final websocket.url.
CONFIG_OTA_URL="https://esp.tjbot.vn/tbot/ota/"
CONFIG_PROVISIONING_STATUS_URL="https://esp.tjbot.vn/tbot/v1/device/provisioning/status"
CONFIG_WEBSOCKET_URL=""
# Keep BluFi discoverable for the contract maximum; phone setup and Wi-Fi
# password entry can exceed the five-minute default.
CONFIG_BLE_SETUP_TIMEOUT_SEC=600
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/v2/16m.csv"
CONFIG_LANGUAGE_VI_VN=y
CONFIG_SR_WN_WN9S_HIESP=y
CONFIG_SR_WN_WN9_HIESP=y
# Switched from server-AEC to device-AEC so wake-word ML only sees clean
# user voice (not robot's own echo). Fixes "Bị Đang lắng nghe liên tục, mic
# thu âm từ loa phát ra" while preserving barge-in (user can still wake
# robot via "Hi ESP" mid-response).
# CONFIG_USE_SERVER_AEC=n
CONFIG_USE_DEVICE_AEC=y

# Mobile app pairing uses local BLE/BluFi discovery. Keep ES3C35P local builds
# on BluFi so the phone can find the robot after BOOT long-press provisioning.
# CONFIG_USE_HOTSPOT_WIFI_PROVISIONING is not set
CONFIG_USE_ESP_BLUFI_WIFI_PROVISIONING=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y
CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY=y

# Lesson runtime keeps a WebSocket open while downloading HTTPS poster/object
# images. The default 3072-byte LWIP tcp/ip task stack overflows on ESP32-S3.
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=8192
CONFIG_TCPIP_TASK_STACK_SIZE=8192

# Fix "esp-aes: Failed to allocate memory" -> ws_disconnect -> "Máy chủ không
# khả dụng" during conversation. While streaming audio, internal SRAM spiked
# down to ~211 B; the HW AES driver (esp-aes) needs a DMA-capable INTERNAL-RAM
# buffer per TLS record and failed to allocate, dropping the WSS connection (and
# the robot could no longer hear -> "con nói lại nhé"). mbedTLS allocations
# already live in PSRAM (MBEDTLS_EXTERNAL_MEM_ALLOC=y), so switching to software
# AES removes TLS's last internal/DMA-RAM dependency. SW AES is plenty fast for
# the low-bitrate audio WSS.
# NOTE: WiFi/LWIP-in-PSRAM (SPIRAM_TRY_ALLOCATE_WIFI_LWIP) was tried and reverted
# — it forced static TX + 32 internal cache-TX buffers, regressed boot TLS
# (HTTP timeouts) and AFE feed draining, and barely moved internal free RAM.
# CONFIG_MBEDTLS_HARDWARE_AES is not set

# Lesson images on SD use descriptive asset paths such as lesson-assets and
# barn-round-field-poster.jpg. Keep FATFS long filename support enabled so the
# robot can sync and read those files directly from the microSD card.
# CONFIG_FATFS_LFN_NONE is not set
CONFIG_FATFS_LFN_HEAP=y

# Robot UART (UART1) dung GPIO44/43 de giao tiep voi slave. GPIO43/44 cung la
# chan console UART0 mac dinh cua ESP32-S3 (U0TXD/U0RXD). Neu de console tren
# UART0, no chu dong day log ra GPIO43 -> tranh chap voi tin hieu slave gui ve
# (main khong doc duoc EVT nut TTP223). Chuyen console sang USB-Serial-JTAG (van
# log/flash qua cong USB nhu cu) de giai phong GPIO43/44 cho robot UART.
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
